{
  "name": "dsh-r-runner",
  "version": "0.1.6",
  "description": "R in the DeepSeek Harness sidebar: an RStudio-shaped workbench with a persistent R session, R syntax highlighting, a file tree with extra folders, an environment pane, a plot gallery, and an agent-facing r_run tool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "r",
    "rstats",
    "rstudio",
    "sidebar",
    "editor",
    "runner",
    "plot"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/import.mjs && node test/driver.mjs && node test/host-unit.mjs && node test/client-tokenize.mjs && node test/client-smoke.mjs",
    "test:session": "node test/driver.mjs",
    "prepublishOnly": "npm test",
    "preview": "node bin/preview-ui.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "seally-web",
    "email": "18306498222@163.com",
    "url": "https://github.com/seally-web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seally-web/dsh-r-runner.git"
  },
  "homepage": "https://github.com/seally-web/dsh-r-runner#readme",
  "bugs": {
    "url": "https://github.com/seally-web/dsh-r-runner/issues"
  }
}
